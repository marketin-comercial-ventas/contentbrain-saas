# Copiar a .env.local (no versionado). Nunca versionar valores reales.

# Conexión PostgreSQL (desarrollo local / pruebas)
DATABASE_URL=postgres://postgres:password@127.0.0.1:5432/app_development

# Servidor de pruebas: las suites de integración crean y borran una base
# dedicada por ejecución (app_test_*) contra esta URL. Si no está definida,
# se usa embedded-postgres (binarios locales; requiere sesión NO administradora
# en Windows). Ejemplo con el servicio local:
# TEST_DATABASE_URL=postgres://postgres:<password>@127.0.0.1:5432/postgres
TEST_DATABASE_URL=

# Migraciones: URL para ejecutar migraciones en base vacía (pipeline CI)
MIGRATIONS_DATABASE_URL=

# Versión expuesta por GET /api/health
APP_VERSION=0.1.0

# ============================================================
# PROVEEDORES IA (configurar al menos uno)
# ============================================================

# OpenAI (GPT-4o, GPT-4o-mini, etc.)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic (Claude 3.5 Sonnet, Haiku, Opus)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Google (Gemini 1.5 Pro, Flash)
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-1.5-pro

# Cohere (Command R+, R)
COHERE_API_KEY=
COHERE_MODEL=command-r-plus

# Mistral (Large, Medium, Small, Codestral)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

# Groq (Llama 3.1, Mixtral, Gemma)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile

# Ollama (local, requiere Ollama corriendo)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Proveedor por defecto (openai | anthropic | google | cohere | mistral | groq | ollama)
AI_PROVIDER=openai

# ============================================================
# AUTENTICACIÓN Y SESIÓN
# ============================================================

# Secret para firmar cookies de sesión (mínimo 32 chars)
SESSION_SECRET=

# ============================================================
# VERCEL (deploy)
# ============================================================

# Vercel CLI token (generar en vercel.com/account/tokens)
VERCEL_TOKEN=

# Vercel Organization ID (Settings > General > Organization ID)
VERCEL_ORG_ID=

# Vercel Project ID (Settings > General > Project ID)
VERCEL_PROJECT_ID=

# ============================================================
# SLACK / NOTIFICACIONES
# ============================================================

# Slack Incoming Webhook URL para notificaciones CI/CD
SLACK_WEBHOOK_URL=

# ============================================================
# DATABASE ADMIN (opcional, para migraciones manuales)
# ============================================================

# PGPASSWORD para psql sin prompt
PGPASSWORD=

# ============================================================
# OPCIONALES: RATE LIMITS, CACHE, ETC.
# ============================================================

# Redis URL (opcional, para cache distribuido futuro)
REDIS_URL=

# Sentry DSN (opcional, error tracking)
SENTRY_DSN=

# ============================================================
# VERSION
# ============================================================

# Versión expuesta por GET /api/health
APP_VERSION=0.1.0